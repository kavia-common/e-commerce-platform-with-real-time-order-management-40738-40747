{"is_source_file": true, "format": "bash script", "description": "This script restores databases from various backup formats including SQLite, PostgreSQL, MySQL, and MongoDB. It automatically detects the backup type and performs the appropriate restore commands based on existing backup files and database availability.", "external_files": ["database_backup.db", "database_backup.sql", "database_backup.archive"], "external_methods": ["pg_isready", "psql", "mysqladmin", "mysql", "mongosh", "mongorestore", "sudo"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres pg_isready", "-h localhost -p ${DB_PORT} -U ${DB_USER} -d postgres < database_backup.sql", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD}", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongorestore --port ${DB_PORT} --archive=database_backup.archive --drop --quiet"], "search-terms": ["restore_db.sh", "database backup restore", "MySQL restore", "PostgreSQL restore", "SQLite backup", "MongoDB restore", "database detection script", "database restore automation"], "state": 2, "file_id": 1, "knowledge_revision": 33, "git_revision": "d310d1f083fc07531afbc253146e34ab676f7654", "revision_history": [{"11": "d310d1f083fc07531afbc253146e34ab676f7654"}, {"33": "d310d1f083fc07531afbc253146e34ab676f7654"}], "hash": "b744d83c878710d3eaac46d844bff6c6", "format-version": 4, "code-base-name": "ecommerce_database", "filename": "ecommerce_database/restore_db.sh"}